<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless end-to-end suite for the FocusAgent (#131). Boots the *real*
    backend + the *real* agent exe and drives session lifecycle over REST,
    asserting against the agent's /status endpoint and the backend's event
    feed. The agent-side analog of the extension's Playwright harness
    (extension/e2e, #124 / #130).

    Deliberately NOT in FocusAgent.sln: `dotnet test FocusAgent.sln` should stay
    a fast unit run. This project is driven by its own CI workflow
    (.github/workflows/agent-e2e.yml) and the documented one-command dev loop.
    It launches the built WinUI agent exe, so it is Windows-only and needs the
    agent built first (the CI workflow and the dev loop both build it).
  -->
  <PropertyGroup>
    <!-- The Windows 10 SDK projection gives the #428 file-picker spec the real
         WinRT FileOpenPicker, which Windows shows in PickerHost like Edge's
         upload dialog. Same TFM as FocusAgent.Native. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- #445: UI Automation (System.Windows.Automation, which ships with the WPF
         framework) lets TrayMenuExitTests read which items the agent's tray menu
         offers, without pixels. Only the framework is referenced: no UseWPF, so
         the implicit usings stay as they are and no WPF UI is built here.
         The framework also carries System.Drawing.Common, which the
         visual-enforcement e2e (#133) uses for BitBlt screenshot capture + PNG
         save, so that no longer needs its own package reference. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <!-- #211: assert the registry write against the canonical policy constants
         (EdgeExtensionPolicy) the agent itself uses, so the spec can't drift from
         the shipped extension id / update-url / forcelist value. -->
    <ProjectReference Include="..\..\src\FocusAgent.Core\FocusAgent.Core.csproj" />
    <!-- #449: built alongside the suite so UpdateApplyTests can copy it into the
         agent install it assembles as that install's Update.exe. Not referenced
         as an assembly; the spec reads it from its own bin folder. -->
    <ProjectReference Include="..\FocusAgent.FakeUpdater\FocusAgent.FakeUpdater.csproj" ReferenceOutputAssembly="false" />
    <!-- #457: built alongside the suite so IntuneInstallScriptTests can put it in
         the Intune package it assembles as Anchor.Agent-win-Setup.exe. Not
         referenced as an assembly; the spec reads it from its own bin folder. -->
    <ProjectReference Include="..\FocusAgent.FakeSetup\FocusAgent.FakeSetup.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
