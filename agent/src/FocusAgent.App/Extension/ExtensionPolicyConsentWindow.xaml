<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FocusAgent.App.Extension.ExtensionPolicyConsentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pds="using:PlinkDesignSystem.Controls">

    <!-- #405: the agent's own explanation before the one UAC prompt that installs
         the Edge extension policy. Same DS ink treatment as the guided-install
         window (ANCHOR_BRAND.md §3): one magenta spark for the primary action
         (allow), a quiet on-ink secondary to say "not now". -->
    <Grid Padding="28,24"
          RowSpacing="14"
          Background="{StaticResource PlinkSurfaceInkBrush}">
        <Grid.Resources>
            <Style x:Key="PlinkOnInkSecondaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource PlinkSecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlinkOnInkBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource PlinkHairlineOnInkBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- eyebrow: the product mark + a calm, static ping. -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
            <pds:Ping Diameter="12"
                      Mode="Static"
                      OnInk="True"
                      VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource PlinkEyebrowTextStyle}"
                       Foreground="{StaticResource PlinkOnInkBrush}"
                       Text="ANCHOR" />
        </StackPanel>

        <!-- headline: in Fraunces display. Copy localized in code. -->
        <TextBlock x:Name="HeadlineText"
                   Grid.Row="1"
                   Style="{StaticResource PlinkDisplaySmallTextStyle}"
                   Foreground="{StaticResource PlinkOnInkBrush}"
                   TextWrapping="Wrap" />

        <!-- what happens next: the one Windows permission prompt. -->
        <TextBlock x:Name="BodyText"
                   Grid.Row="2"
                   Style="{StaticResource PlinkBodyLargeTextStyle}"
                   Foreground="{StaticResource PlinkOnInkMutedBrush}"
                   TextWrapping="Wrap" />

        <!-- what Edge will say afterwards ("managed by your organization"), in
             quiet mono microcopy. -->
        <TextBlock x:Name="NoteText"
                   Grid.Row="3"
                   Style="{StaticResource PlinkLabelTextStyle}"
                   Foreground="{StaticResource PlinkOnInkMutedBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button x:Name="NotNowButton"
                    Style="{StaticResource PlinkOnInkSecondaryButtonStyle}"
                    Click="OnNotNowClicked" />
            <!-- ALLOW: the single magenta spark — the one primary action. -->
            <Button x:Name="AllowButton"
                    Style="{StaticResource PlinkPrimaryButtonStyle}"
                    Click="OnAllowClicked" />
        </StackPanel>
    </Grid>
</Window>
