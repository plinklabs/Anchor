{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Entra/Azure AD identifiers are environment-specific and MUST NOT be
  // committed. In production they come from Azure App Service application
  // settings (double-underscore form: AzureAd__TenantId, AzureAd__ClientId,
  // AzureAd__Audience, and AzureAd__ClientCredentials for OBO/Graph). Local
  // dev values live in appsettings.Development.json.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  // Allowed CORS origins for the dashboard SPA are environment-specific and
  // MUST NOT be committed. In production set them via App Service settings
  // (Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, ...). Local dev values
  // live in appsettings.Development.json.
  "Cors": {
    "AllowedOrigins": []
  },
  // A joined student whose agent sends no heartbeat within
  // AgentJoinGraceSeconds shows on the teacher's roster as agent missing (#444).
  "Heartbeat": {
    "IntervalSeconds": 10,
    "TimeoutMultiplier": 2,
    "ScanIntervalSeconds": 5,
    "AgentJoinGraceSeconds": 30
  },
  "EventRetention": {
    "RawEventDays": 14,
    "PruneIntervalMinutes": 1440,
    "PruneHourUtc": 2,
    "BatchSize": 10000
  },
  // A session ends at its planned end (#447). One still running MaxDuration
  // after it started is treated as forgotten and ended, exactly as if the
  // teacher had clicked End (#345): the last safety net, checked every
  // SweepInterval. A zero MaxDuration turns that safety net off.
  "SessionAutoEnd": {
    "MaxDuration": "04:00:00",
    "SweepInterval": "00:05:00"
  },
  // The agents' log uploads of the test phase (#446). Off unless Enabled is
  // true; switched off, the backend asks no agent for anything. Each agent then
  // uploads its log lines from WindowBefore before each session it was on the
  // roster of started to WindowAfter after it ended, and nothing else, for
  // sessions of the last LookbackDays. Uploads are at most MaxUploadBytes
  // (gzipped) and are deleted RetentionDays after they arrived. Only admins can
  // download them.
  "LogUpload": {
    "Enabled": false,
    "WindowBefore": "00:30:00",
    "WindowAfter": "00:10:00",
    "LookbackDays": 14,
    "RetentionDays": 14,
    "MaxUploadBytes": 1048576
  },
  // The schools' lesson periods are wall-clock times in TimeZone (#447). A
  // session started within RolloverWindow of a period's end counts as started
  // in the next period.
  "LessonPeriods": {
    "TimeZone": "Europe/Brussels",
    "RolloverWindow": "00:05:00"
  }
}
