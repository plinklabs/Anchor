<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <!-- Transitive pin (#467), not used directly. Pkcs <= 10.0.12 / 9.0.20 has
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. No parent resolves a
         patched one yet: EF Core SqlServer 10.0.13 brings Microsoft.Data.SqlClient
         6.1.7 (Pkcs 9.0.11), and Microsoft.Identity.Web up to 4.16.1 (Anchor.Api)
         wants Pkcs 10.0.10. Pinned here so it flows to Anchor.Api and the tests.
         Drop it once SqlClient and Identity.Web depend on a patched Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anchor.Domain\Anchor.Domain.csproj" />
  </ItemGroup>

</Project>
